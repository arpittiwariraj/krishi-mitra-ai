# ---------------------------------------------------------------------------
# Krishi Mitra AI - Backend environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/krishi_mitra

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI multimodal disease analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenWeather (current weather + forecast + geocoding)
OPENWEATHER_API_KEY=

# data.gov.in / AGMARKNET mandi price resource
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Set to true only to show explicitly labelled demonstration market data
MARKET_DEMO_MODE=false
# Default transport cost used by the market comparison calculator (INR / km)
DEFAULT_TRANSPORT_COST_PER_KM=0

# CORS
FRONTEND_URL=http://localhost:5173

# Optional: enable AI narration for weather advisories (rule engine still runs)
ENABLE_AI_WEATHER_ADVISORY=false
